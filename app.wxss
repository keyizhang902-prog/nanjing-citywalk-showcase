/* 全局样式 */
page {
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
}

.container {
  width: 100%;
  min-height: 100vh;
}

.btn {
  width: 80%;
  height: 50px;
  background-color: #1989fa;
  color: white;
  border-radius: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  margin: 20px auto;
  cursor: pointer;
}

.btn:active {
  background-color: #1677ff;
}
