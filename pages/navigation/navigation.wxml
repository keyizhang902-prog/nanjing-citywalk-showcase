<view style="padding:16rpx;background:#fff4db;color:#73551c;font-size:24rpx;">公开展示版 · 路线规划、导航与评分服务未接入</view>
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
      <text>返回</text>
    </view>
    <text class="nav-title">实时导航</text>
    <view class="placeholder"></view>
  </view>

  <!-- 地图区域 -->
  <view class="map-container">
    <map wx:if="{{route && route.points.length > 1}}"
      id="map"
      class="map-view"
      longitude="{{route.points[0].longitude}}"
      latitude="{{route.points[0].latitude}}"
      scale="14"
      show-location="true"
      markers="{{markers}}"
      polyline="{{polyline}}"
    ></map>
  </view>

  <view wx:if="{{isPlanning}}">正在规划完整步行路线…</view>
  <view wx:if="{{routeError}}">{{routeError}}<button wx:if="{{route && !exceedsTimeLimit}}" bindtap="retryRoute">重试</button></view>

  <!-- 路线信息 -->
  <view class="route-info">
    <text class="route-source" wx:if="{{routeServiceSource}}">路网服务：{{routeServiceSource}}</text>
    <view class="nav-stats">
      <view class="stat-item">
        <text class="stat-label">总距离</text>
        <text class="stat-value">{{totalDistance}}米</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">预计时间</text>
        <text class="stat-value">{{totalTimeDisplay}}分钟</text>
      </view>
    </view>

    <!-- 到起点路线信息 -->
    <view class="route-to-start-info" wx:if="{{showRouteToStart}}">
      <view class="route-to-start-header">
        <text class="route-to-start-title">到起点路线</text>
        <text class="route-to-start-close" bindtap="hideRouteToStart">隐藏</text>
      </view>
      <view class="route-to-start-stats">
        <text class="route-to-start-distance">距离: {{routeToStartDistance}}米</text>
        <text class="route-to-start-time">时间: {{routeToStartTimeDisplay}}分钟</text>
      </view>
    </view>

    <!-- 美食推荐信息 - 仅显示用户选择的美食 -->
    <view class="food-recommendation" wx:if="{{showFood && selectedFoods.length > 0 && !isNavigating}}">
      <view class="food-header">
        <text class="food-title">🍜 已选美食</text>
      </view>
      <view class="food-list">
        <!-- 仅显示用户选择的美食 -->
        <view class="food-item" wx:for="{{selectedFoods}}" wx:key="name">
          <view class="food-header">
            <text class="food-name">{{item.name}}</text>
            <text class="food-rating" wx:if="{{item.rating > 0}}">{{item.rating}}分</text>
          </view>
          <view class="food-advantages">
            <text class="food-advantage" wx:for="{{item.advantages}}" wx:for-item="adv" wx:key="index">{{adv}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 导航按钮组 -->
    <view class="nav-buttons-group" wx:if="{{!isNavigating}}">
      <view class="nav-btn-item" wx:if="{{userLocation && showRouteToStart}}">
        <view class="btn btn-secondary" bindtap="startNavigateToStart">开始去起点导航</view>
      </view>
      <view class="nav-btn-item" wx:if="{{userLocation && !showRouteToStart}}">
        <view class="btn btn-secondary" bindtap="planRouteToStart">规划去起点路线</view>
      </view>
      <view class="nav-btn-item">
        <view class="btn btn-primary" bindtap="startRouteNavigation">开始您的citywalk之旅</view>
      </view>
    </view>

    <!-- 导航指引面板 -->
    <view class="navigation-guide" wx:if="{{isNavigating}}">
      <view class="guide-header">
        <text class="guide-title" wx:if="{{navigationMode === 'toStart'}}">导航去起点</text>
        <text class="guide-title" wx:if="{{navigationMode === 'fromStart'}}">景点导航</text>
        <text class="guide-progress">{{currentStep + 1}} / {{currentNavigationSteps.length}}</text>
      </view>
      <view class="guide-content">
        <view class="current-step">
          <text class="step-label">当前</text>
          <text class="step-instruction">{{currentNavigationSteps[currentStep] && currentNavigationSteps[currentStep].instruction ? currentNavigationSteps[currentStep].instruction : '准备出发'}}</text>
          <text class="step-distance">{{currentNavigationSteps[currentStep] && currentNavigationSteps[currentStep].distance ? currentNavigationSteps[currentStep].distance : 0}}米</text>
        </view>
        <view class="next-step" wx:if="{{currentStep < currentNavigationSteps.length - 1}}">
          <text class="step-label">下一步</text>
          <text class="step-instruction">{{currentNavigationSteps[currentStep + 1] && currentNavigationSteps[currentStep + 1].instruction ? currentNavigationSteps[currentStep + 1].instruction : '继续前进'}}</text>
          <text class="step-distance">{{currentNavigationSteps[currentStep + 1] && currentNavigationSteps[currentStep + 1].distance ? currentNavigationSteps[currentStep + 1].distance : 0}}米</text>
        </view>
      </view>
      <view class="guide-actions">
        <view class="btn btn-secondary" bindtap="prevStep" wx:if="{{currentStep > 0}}">上一步</view>
        <view class="btn btn-primary" bindtap="nextStep" wx:if="{{currentStep < currentNavigationSteps.length - 1}}">下一步</view>
        <view class="btn btn-success" bindtap="finishNavigation" wx:if="{{currentStep === currentNavigationSteps.length - 1}}">{{navigationMode === 'toStart' ? '到达起点' : '到达终点'}}</view>
        <view class="btn btn-danger" bindtap="stopNavigation">停止导航</view>
      </view>
    </view>
  </view>

  <!-- 评分模态框 -->
  <view class="rating-modal" wx:if="{{showRatingModal}}">
    <view class="modal-mask" bindtap="closeRatingModal"></view>
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">路线评分</text>
        <view class="modal-close" bindtap="closeRatingModal">×</view>
      </view>

      <view class="modal-body">
        <text class="rating-title">请对本次路线进行评分（{{cloudEnabled ? '保存到云端' : '保存在本机'}}）</text>

        <!-- 景点推荐程度评分 -->
        <view class="rating-section">
          <text class="rating-label">景点推荐程度</text>
          <view class="star-rating">
            <text class="star {{attractionRating >= 1 ? 'active' : ''}}" bindtap="setAttractionRating" data-rating="1">★</text>
            <text class="star {{attractionRating >= 2 ? 'active' : ''}}" bindtap="setAttractionRating" data-rating="2">★</text>
            <text class="star {{attractionRating >= 3 ? 'active' : ''}}" bindtap="setAttractionRating" data-rating="3">★</text>
            <text class="star {{attractionRating >= 4 ? 'active' : ''}}" bindtap="setAttractionRating" data-rating="4">★</text>
            <text class="star {{attractionRating >= 5 ? 'active' : ''}}" bindtap="setAttractionRating" data-rating="5">★</text>
          </view>
        </view>

        <!-- 步行舒适度评分 -->
        <view class="rating-section">
          <text class="rating-label">步行舒适度</text>
          <view class="star-rating">
            <text class="star {{comfortRating >= 1 ? 'active' : ''}}" bindtap="setComfortRating" data-rating="1">★</text>
            <text class="star {{comfortRating >= 2 ? 'active' : ''}}" bindtap="setComfortRating" data-rating="2">★</text>
            <text class="star {{comfortRating >= 3 ? 'active' : ''}}" bindtap="setComfortRating" data-rating="3">★</text>
            <text class="star {{comfortRating >= 4 ? 'active' : ''}}" bindtap="setComfortRating" data-rating="4">★</text>
            <text class="star {{comfortRating >= 5 ? 'active' : ''}}" bindtap="setComfortRating" data-rating="5">★</text>
          </view>
        </view>

        <!-- 评分说明 -->
        <view class="rating-tips">
          <text>5星：非常满意</text>
          <text>4星：满意</text>
          <text>3星：一般</text>
          <text>2星：不满意</text>
          <text>1星：非常不满意</text>
        </view>
      </view>

      <view class="modal-footer">
        <view class="btn btn-secondary" bindtap="closeRatingModal">取消</view>
        <button class="btn btn-primary" bindtap="submitRating" loading="{{isSubmittingRating}}" disabled="{{isSubmittingRating}}">提交评分</button>
      </view>
    </view>
  </view>
</view>
