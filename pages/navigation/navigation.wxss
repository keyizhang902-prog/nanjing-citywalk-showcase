.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  position: relative;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  color: #007AFF;
  font-size: 28rpx;
}

.back-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 80rpx;
}

/* 地图区域 */
.map-container {
  flex: 1;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.map-view {
  width: 100%;
  height: 100%;
}

/* 路线信息 */
.route-info {
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  position: relative;
  z-index: 100;
}

.nav-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 到起点路线信息 */
.route-to-start-info {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #E8F5E9;
  border-radius: 10rpx;
  border-left: 8rpx solid #4CAF50;
}

.route-to-start-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.route-to-start-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E7D32;
}

.route-to-start-close {
  font-size: 24rpx;
  color: #666;
  padding: 5rpx 10rpx;
}

.route-to-start-stats {
  display: flex;
  gap: 30rpx;
}

.route-to-start-distance,
.route-to-start-time {
  font-size: 26rpx;
  color: #333;
}

/* 导航按钮组 */
.nav-buttons-group {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.nav-btn-item {
  flex: 1;
}

.btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary {
  background-color: #007AFF;
  color: white;
}

.btn-secondary {
  background-color: #4CAF50;
  color: white;
}

.btn-danger {
  background-color: #FF3B30;
  color: white;
}

.btn-success {
  background-color: #34C759;
  color: white;
}

/* 导航指引面板 */
.navigation-guide {
  margin-top: 20rpx;
  padding: 30rpx;
  background-color: #f8f8f8;
  border-radius: 20rpx;
}

.guide-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ddd;
}

.guide-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.guide-progress {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: bold;
}

.guide-content {
  margin-bottom: 20rpx;
}

.current-step, .next-step {
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 10rpx;
}

.current-step {
  background-color: #007AFF;
  color: white;
}

.next-step {
  background-color: #E5E5EA;
  color: #333;
}

.step-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 10rpx;
}

.step-instruction {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.step-distance {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

.guide-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.guide-actions .btn {
  flex: 1;
  min-width: 200rpx;
}

/* 美食推荐信息 */
.food-recommendation {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #FFF8E1;
  border-radius: 10rpx;
  border-left: 8rpx solid #FFA500;
}

.food-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.food-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6F00;
}

.food-rating {
  font-size: 24rpx;
  color: #FF9500;
  font-weight: bold;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.food-item {
  padding: 15rpx;
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.food-advantages {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.food-advantage {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
}

.food-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  font-weight: 500;
}

/* 评分模态框 */
.rating-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background-color: white;
  width: 80%;
  max-width: 500rpx;
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 1001;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.rating-title {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  font-weight: 500;
}

.rating-section {
  margin-bottom: 40rpx;
}

.rating-label {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.star-rating {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  cursor: pointer;
  transition: all 0.3s;
}

.star.active {
  color: #FFD700;
}

.rating-tips {
  margin-top: 40rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.rating-tips text {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.modal-footer .btn {
  flex: 1;
  margin: 0;
}

.modal-footer .btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}
.route-source {
  display: block;
  margin-bottom: 12rpx;
  color: #1677ff;
  font-size: 24rpx;
}
