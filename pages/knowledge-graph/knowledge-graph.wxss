/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #667eea;
  color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.back-btn {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

.placeholder {
  width: 100rpx;
}

/* 主内容区域 */
.main-content {
  padding: 120rpx 30rpx 30rpx;
}

/* 搜索栏 */
.search-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding-right: 20rpx;
}

.search-icon {
  font-size: 32rpx;
}

/* 统计区域 */
.stats-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 思维导图区域 */
.mindmap-section {
  margin-bottom: 24rpx;
}

.mindmap-container {
  position: relative;
  height: 700rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 连接线SVG */
.relation-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 中心节点 */
.center-node {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(135deg, #E91E63, #9C27B0);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(233, 30, 99, 0.4);
  z-index: 10;
}

.center-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.center-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.center-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 第一层节点 */
.level1-node {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
  min-width: 180rpx;
}

.level1-node:active {
  transform: scale(0.95);
}

.node-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.node-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.node-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.relation-label {
  font-size: 20rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 子节点区域 */
.sub-nodes {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-top: 15rpx;
  border-top: 1rpx dashed #eee;
}

.sub-node {
  display: flex;
  align-items: center;
  padding: 10rpx 15rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  width: 100%;
}

.sub-node:active {
  background-color: #e9ecef;
}

.sub-node-name {
  font-size: 22rpx;
  color: #333;
  flex: 1;
}

.sub-relation {
  font-size: 18rpx;
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

/* 展开按钮 */
.expand-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

/* 不同类型节点样式 */
.water-node {
  border-top: 4rpx solid #2196F3;
}

.literature-node {
  border-top: 4rpx solid #4CAF50;
}

.heritage-node {
  border-top: 4rpx solid #FF9800;
}

.person-node {
  border-top: 4rpx solid #9C27B0;
}

.landscape-node {
  border-top: 4rpx solid #00BCD4;
}

/* 图例区域 */
.legend-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.legend-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.legend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  width: calc(50% - 10rpx);
}

.legend-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.modal-info {
  flex: 1;
}

.modal-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.modal-type {
  font-size: 24rpx;
  color: #999;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-section {
  margin-bottom: 30rpx;
}

.modal-section:last-child {
  margin-bottom: 0;
}

.modal-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.modal-section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.modal-relations {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-relation {
  background-color: #f8f9fa;
  padding: 16rpx;
  border-radius: 12rpx;
}

.relation-path {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.relation-start, .relation-end {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.relation-arrow {
  font-size: 24rpx;
  color: #999;
}

.relation-label {
  font-size: 22rpx;
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.empty-relations {
  text-align: center;
  color: #999;
  padding: 30rpx;
}

/* 底部说明 */
.footer {
  text-align: center;
  padding: 30rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
}
